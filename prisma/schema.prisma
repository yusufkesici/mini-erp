generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Ürün tipi: Hammadde / Yarı Mamul / Mamul (Bitmiş Ürün)
enum ProductType {
  RAW_MATERIAL // Hammadde
  SEMI_FINISHED // Yarı Mamul
  FINISHED_GOOD // Mamul / Bitmiş Ürün
}

/// Temel ölçü birimleri (MVP — genişletilebilir)
enum UnitOfMeasure {
  PIECE // Adet
  KG // Kilogram
  GRAM // Gram
  LITER // Litre
  METER // Metre
  BOX // Koli
  PACKAGE // Paket
}

/// Üretim emri durumu
enum ProductionOrderStatus {
  PLANNED // Planlandı
  IN_PROGRESS // Üretimde
  COMPLETED // Tamamlandı
  CANCELLED // İptal edildi
}

/// Stok hareketi tipi — yön (giriş/çıkış) ve neden tek alanda birleşik
enum StockMovementType {
  PURCHASE_IN // Satın alma girişi
  SALES_OUT // Satış çıkışı
  PRODUCTION_IN // Üretimden gelen çıktı girişi
  PRODUCTION_CONSUME_OUT // Üretimde tüketilen bileşen çıkışı
  ADJUSTMENT_IN // Sayım/düzeltme girişi
  ADJUSTMENT_OUT // Sayım/düzeltme çıkışı
}

model Product {
  id          String        @id @default(cuid())
  code        String        @unique // SKU / Ürün Kodu
  barcode     String?       @unique
  name        String
  description String?
  type        ProductType
  unit        UnitOfMeasure @default(PIECE)

  costPrice Decimal? @db.Decimal(12, 2) // Alış / maliyet fiyatı
  salePrice Decimal? @db.Decimal(12, 2) // Satış fiyatı

  isActive  Boolean   @default(true)
  deletedAt DateTime? // soft delete

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stocks Stock[]

  billOfMaterials  BillOfMaterial[] // bu ürünün çıktısı olduğu tarifler
  bomComponentOf   BillOfMaterialItem[] // bu ürünün bileşen olarak kullanıldığı BOM satırları
  productionOrders ProductionOrder[] // bu ürünün üretildiği üretim emirleri
  stockMovements   StockMovement[] // bu ürüne ait stok hareketleri

  @@index([type])
  @@index([isActive])
  @@map("products")
}

model Warehouse {
  id       String  @id @default(cuid())
  code     String  @unique
  name     String
  address  String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stocks Stock[]

  productionOrders ProductionOrder[] // bu depoda gerçekleşen üretim emirleri
  stockMovements   StockMovement[] // bu depoya ait stok hareketleri

  @@map("warehouses")
}

model Stock {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  quantity      Decimal  @default(0) @db.Decimal(18, 4) // kesirli birimler (kg, litre) desteklenir
  minStockLevel Decimal? @db.Decimal(18, 4) // kritik stok seviyesi / reorder point

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, warehouseId])
  @@index([warehouseId])
  @@map("stocks")
}

/// Ürün ağacı (BOM) başlığı — bir ürünün hangi tarifle üretildiğini tanımlar
model BillOfMaterial {
  id String @id @default(cuid())

  productId String // çıktı ürünü (SEMI_FINISHED veya FINISHED_GOOD olmalı)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  name           String? // örn. "Standart Reçete v2"
  isActive       Boolean @default(true) // üründe aynı anda tek aktif BOM önerilir
  outputQuantity Decimal @default(1) @db.Decimal(18, 4) // bu tarifin ürettiği miktar

  items            BillOfMaterialItem[]
  productionOrders ProductionOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@map("bill_of_materials")
}

/// Ürün ağacı satırı — bir BOM'un bileşenlerinden biri
model BillOfMaterialItem {
  id String @id @default(cuid())

  bomId String
  bom   BillOfMaterial @relation(fields: [bomId], references: [id], onDelete: Cascade)

  componentProductId String // bileşen ürün
  component           Product @relation(fields: [componentProductId], references: [id], onDelete: Restrict)

  quantity Decimal @db.Decimal(18, 4) // outputQuantity başına gereken miktar

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bomId, componentProductId])
  @@map("bill_of_material_items")
}

/// Üretim emri — bir BOM'a göre belirli miktarda ürün üretme talimatı
model ProductionOrder {
  id String @id @default(cuid())

  productId String // üretilecek ürün
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  bomId String // kullanılan tarif (izlenebilirlik için zorunlu)
  bom   BillOfMaterial @relation(fields: [bomId], references: [id], onDelete: Restrict)

  warehouseId String // bileşenlerin tüketildiği / çıktının girdiği depo
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  plannedQuantity  Decimal               @db.Decimal(18, 4) // hedeflenen üretim miktarı
  producedQuantity Decimal               @default(0) @db.Decimal(18, 4) // gerçekleşen miktar
  status           ProductionOrderStatus @default(PLANNED)

  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  actualStartDate  DateTime?
  actualEndDate    DateTime?

  movements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([status])
  @@map("production_orders")
}

/// Stok hareketi — değiştirilemez denetim defteri (ledger); Stock tablosu bu hareketler üzerinden güncellenir
model StockMovement {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  productionOrderId String? // yalnızca üretim kaynaklı hareketlerde dolu
  productionOrder   ProductionOrder? @relation(fields: [productionOrderId], references: [id], onDelete: SetNull)

  type     StockMovementType
  quantity Decimal           @db.Decimal(18, 4) // her zaman pozitif; yön `type` alanından gelir
  note     String?

  createdAt DateTime @default(now()) // yalnızca createdAt — kayıt değiştirilmez, updatedAt yok

  @@index([productId, warehouseId])
  @@index([productionOrderId])
  @@map("stock_movements")
}
