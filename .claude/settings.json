{
  "worktree": {
    "bgIsolation": "none"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \".claude/hooks/post-edit-lint.sh\"",
            "statusMessage": "Değişen dosyada lint/format çalıştırılıyor..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \".claude/hooks/guard-bash-negative-stock.js\"",
            "statusMessage": "Negatif stok koruması kontrol ediliyor..."
          },
          {
            "type": "command",
            "command": "node \".claude/hooks/guard-migrations-bash.js\"",
            "statusMessage": "Migration koruması kontrol ediliyor..."
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \".claude/hooks/guard-edit-negative-stock.js\"",
            "statusMessage": "Negatif stok koruması kontrol ediliyor..."
          },
          {
            "type": "command",
            "command": "node \".claude/hooks/guard-migrations-write.js\"",
            "statusMessage": "Migration koruması kontrol ediliyor..."
          }
        ]
      }
    ]
  }
}
