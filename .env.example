DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mini_erp?schema=public"

# HTTP API'ye erişmek için gereken paylaşılan anahtar (bkz. src/auth/api-key.guard.ts).
# Her istek bunu `x-api-key` header'ında göndermeli. Üretimde uzun/rastgele bir değerle değiştirin.
API_KEY="dev-secret-change-me"

# Frontend'in CORS için izin verdiği origin(ler) (bkz. src/main.ts).
# Virgülle ayrılmış birden fazla origin verilebilir — ör. telefon/LAN'dan erişim için
# bilgisayarın Wi-Fi IPv4 adresini de ekleyin, frontend vite-plugin-mkcert ile HTTPS
# çalışıyorsa https:// origin'lerini de eklemeyi unutmayın:
# "http://localhost:5173,http://192.168.1.62:5173,https://localhost:5173,https://192.168.1.62:5173"
CORS_ORIGIN="http://localhost:5173"
